{
  "$description": "장봄 디자인 토큰 · Figma 베리어블(장봄/primitive · semantic · spacing · radius · typography)에서 추출 · 원시는 값, 의미는 원시 참조",
  "color": {
    "primitive": {
      "gray": {
        "0":   { "$type": "color", "$value": "#ffffff" },
        "100": { "$type": "color", "$value": "#f7f7f7" },
        "200": { "$type": "color", "$value": "#f0f1f4" },
        "300": { "$type": "color", "$value": "#dadde0" },
        "400": { "$type": "color", "$value": "#99a1a8" },
        "500": { "$type": "color", "$value": "#757d86" },
        "600": { "$type": "color", "$value": "#50585f" },
        "800": { "$type": "color", "$value": "#21242a" },
        "900": { "$type": "color", "$value": "#131518" }
      },
      "green": {
        "50":  { "$type": "color", "$value": "#eef7f1" },
        "100": { "$type": "color", "$value": "#d9efe1" },
        "300": { "$type": "color", "$value": "#bcd638" },
        "600": { "$type": "color", "$value": "#2a8550" },
        "700": { "$type": "color", "$value": "#23774a" }
      },
      "orange": {
        "50":  { "$type": "color", "$value": "#fff5eb" },
        "700": { "$type": "color", "$value": "#b45309" }
      },
      "red": {
        "50":  { "$type": "color", "$value": "#fff0f3" },
        "500": { "$type": "color", "$value": "#e30036" }
      },
      "yellow": {
        "50":  { "$type": "color", "$value": "#fffbe0" },
        "300": { "$type": "color", "$value": "#ffef79" }
      }
    },
    "semantic": {
      "text": {
        "primary":     { "$type": "color", "$value": "{color.primitive.gray.900}" },
        "secondary":   { "$type": "color", "$value": "{color.primitive.gray.600}" },
        "tertiary":    { "$type": "color", "$value": "{color.primitive.gray.500}" },
        "placeholder": { "$type": "color", "$value": "{color.primitive.gray.400}" },
        "on-primary":  { "$type": "color", "$value": "{color.primitive.gray.0}" },
        "accent":      { "$type": "color", "$value": "{color.primitive.green.600}" },
        "warning":     { "$type": "color", "$value": "{color.primitive.orange.700}" },
        "error":       { "$type": "color", "$value": "{color.primitive.red.500}" },
        "disabled":    { "$type": "color", "$value": "{color.primitive.gray.500}" }
      },
      "bg": {
        "card":           { "$type": "color", "$value": "{color.primitive.gray.0}" },
        "page":           { "$type": "color", "$value": "{color.primitive.gray.100}" },
        "subtle":         { "$type": "color", "$value": "{color.primitive.gray.200}" },
        "accent":         { "$type": "color", "$value": "{color.primitive.yellow.300}" },
        "accent-subtle":  { "$type": "color", "$value": "{color.primitive.yellow.50}" },
        "warning-subtle": { "$type": "color", "$value": "{color.primitive.orange.50}" },
        "error-subtle":   { "$type": "color", "$value": "{color.primitive.red.50}" },
        "inverse":        { "$type": "color", "$value": "{color.primitive.gray.800}" },
        "highlight":      { "$type": "color", "$value": "{color.primitive.green.50}" }
      },
      "fill": {
        "primary":         { "$type": "color", "$value": "{color.primitive.green.600}" },
        "primary-pressed": { "$type": "color", "$value": "{color.primitive.green.700}" },
        "secondary":       { "$type": "color", "$value": "{color.primitive.gray.900}" },
        "tertiary":        { "$type": "color", "$value": "{color.primitive.gray.200}" },
        "disabled":        { "$type": "color", "$value": "{color.primitive.gray.300}" }
      },
      "border": {
        "default": { "$type": "color", "$value": "{color.primitive.gray.300}" },
        "subtle":  { "$type": "color", "$value": "{color.primitive.gray.200}" },
        "strong":  { "$type": "color", "$value": "{color.primitive.gray.900}" },
        "focus":   { "$type": "color", "$value": "{color.primitive.green.600}" },
        "error":   { "$type": "color", "$value": "{color.primitive.red.500}" },
        "divider": { "$type": "color", "$value": "{color.primitive.gray.200}" }
      },
      "icon": {
        "default":  { "$type": "color", "$value": "{color.primitive.gray.600}" },
        "strong":   { "$type": "color", "$value": "{color.primitive.gray.900}" },
        "accent":   { "$type": "color", "$value": "{color.primitive.green.600}" },
        "disabled": { "$type": "color", "$value": "{color.primitive.gray.300}" },
        "subtle":   { "$type": "color", "$value": "{color.primitive.gray.400}" }
      }
    }
  },
  "spacing": {
    "primitive": {
      "0":  { "$type": "dimension", "$value": "0px" },
      "4":  { "$type": "dimension", "$value": "4px" },
      "8":  { "$type": "dimension", "$value": "8px" },
      "12": { "$type": "dimension", "$value": "12px" },
      "16": { "$type": "dimension", "$value": "16px" },
      "20": { "$type": "dimension", "$value": "20px" },
      "24": { "$type": "dimension", "$value": "24px" },
      "32": { "$type": "dimension", "$value": "32px" },
      "40": { "$type": "dimension", "$value": "40px" }
    },
    "semantic": {
      "page-horizontal": { "$type": "dimension", "$value": "{spacing.primitive.16}" },
      "stack-sm":        { "$type": "dimension", "$value": "{spacing.primitive.8}" },
      "stack-md":        { "$type": "dimension", "$value": "{spacing.primitive.16}" },
      "stack-lg":        { "$type": "dimension", "$value": "{spacing.primitive.24}" },
      "inline-sm":       { "$type": "dimension", "$value": "{spacing.primitive.4}" },
      "inline-md":       { "$type": "dimension", "$value": "{spacing.primitive.8}" },
      "control-x":       { "$type": "dimension", "$value": "{spacing.primitive.16}" },
      "control-y":       { "$type": "dimension", "$value": "{spacing.primitive.12}" }
    }
  },
  "radius": {
    "primitive": {
      "4":    { "$type": "dimension", "$value": "4px" },
      "8":    { "$type": "dimension", "$value": "8px" },
      "12":   { "$type": "dimension", "$value": "12px" },
      "full": { "$type": "dimension", "$value": "999px" }
    },
    "semantic": {
      "button":  { "$type": "dimension", "$value": "{radius.primitive.8}" },
      "control": { "$type": "dimension", "$value": "{radius.primitive.8}" },
      "card":    { "$type": "dimension", "$value": "{radius.primitive.12}" },
      "pill":    { "$type": "dimension", "$value": "{radius.primitive.full}" },
      "media":   { "$type": "dimension", "$value": "{radius.primitive.4}" }
    }
  },
  "typography": {
    "primitive": {
      "font-family": {
        "base": { "$type": "fontFamily", "$value": ["Noto Sans KR", "sans-serif"] }
      },
      "font-size": {
        "12": { "$type": "dimension", "$value": "12px" },
        "14": { "$type": "dimension", "$value": "14px" },
        "16": { "$type": "dimension", "$value": "16px" },
        "18": { "$type": "dimension", "$value": "18px" },
        "20": { "$type": "dimension", "$value": "20px" },
        "24": { "$type": "dimension", "$value": "24px" }
      }
    }
  }
}
